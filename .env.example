# Where VORTEX stores logs/data/models. Defaults to ~/.vortex if unset - only
# set this if you want them somewhere specific (e.g. an existing install's
# path, to preserve continuity with logs/memory it already wrote there).
# VORTEX_HOME=E:\VORTEX
VORTEX_VOICE=en-US-AvaMultilingualNeural
USER_NAME=Boss

# RAG stack (Phase 5) - PostgreSQL for document/chunk metadata, Qdrant for vector
# search. Both are local services you run yourself (see README); VORTEX degrades
# gracefully to plain document reads if they aren't running.
VORTEX_POSTGRES_DSN=dbname=vortex user=vortex password=CHANGE_ME host=localhost
VORTEX_QDRANT_URL=http://localhost:6333
VORTEX_EMBED_MODEL=nomic-embed-text

# Gmail integration - "check my email" / "reply to X and say Y" (drafts via
# the LLM, sends only after you say yes). Needs a one-time OAuth setup - see
# README's "Setting up Gmail" section. Defaults shown; only set these if you
# put the files somewhere other than VORTEX_HOME.
# VORTEX_GMAIL_CREDENTIALS=E:\VORTEX\gmail_credentials.json
# VORTEX_GMAIL_TOKEN=E:\VORTEX\data\gmail_token.json
# VORTEX_MAIL_MAX_RESULTS=5

# Structured tool-calling (Phase 4 gap) - real, tested infrastructure, but
# off by default: live-tested unreliable on every model on this machine
# (hallucinated/malformed tool calls). See IMPLEMENTED.md's Phase 4 row
# before flipping this on.
# VORTEX_LLM_TOOL_CALLING_ENABLED=false
