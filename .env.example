VORTEX_VOICE=en-US-AvaMultilingualNeural
USER_NAME=Boss

# RAG stack (Phase 5) - PostgreSQL for document/chunk metadata, Qdrant for vector
# search. Both are local services you run yourself (see README); VORTEX degrades
# gracefully to plain document reads if they aren't running.
VORTEX_POSTGRES_DSN=dbname=vortex user=vortex password=CHANGE_ME host=localhost
VORTEX_QDRANT_URL=http://localhost:6333
VORTEX_EMBED_MODEL=nomic-embed-text
